.info-key{color:#90a4ae;font-size:11px;min-width:90px}
.info-val{color:#eee;font-size:11px;text-align:right;max-width:180px;word-wrap:break-word}
.info-layer-tag{display:inline-block;padding:2px 8px;border-radius:3px;font-size:10px;font-weight:bold;margin-bottom:6px}
