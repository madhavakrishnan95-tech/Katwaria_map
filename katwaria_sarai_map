var map=L.map("map",{zoomControl:true});

var baseLayers={
  "Google Hybrid":L.tileLayer("https://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}",{maxZoom:22}),
  "Google Satellite":L.tileLayer("https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",{maxZoom:22}),
  "Google Street":L.tileLayer("https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",{maxZoom:22}),
  "Google Terrain":L.tileLayer("https://mt1.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",{maxZoom:22}),
  "OSM":L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"OpenStreetMap"}),
  "ESRI World Imagery":L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",{maxZoom:19,attribution:"Esri"}),
  "ESRI Topo":L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",{maxZoom:19,attribution:"Esri"})
};
baseLayers["Google Hybrid"].addTo(map);
L.control.layers(baseLayers,{},{position:"bottomright",collapsed:true}).addTo(map);

function wColor(w){if(!w||w<=0)return"#555";if(w<2)return"#e65100";if(w<3)return"#f57f17";if(w<4)return"#2e7d32";if(w<6)return"#00bcd4";return"#42a5f5"}
function floorColor(v){if(!v)return"#555";var s=String(v).trim();var m=s.match(/(\d+)\s*[-]\s*(\d+)/);var n=m?(parseInt(m[1])+parseInt(m[2]))/2:(parseInt(s)||0);if(n<=0)return"#555";if(n<=2)return"#a5d6a7";if(n<=3)return"#66bb6a";if(n<=4)return"#fdd835";if(n<=5)return"#ff9800";if(n<=6)return"#f44336";return"#b71c1c"}
function safeStr(v){return v==null||v===""?"—":String(v)}

var STYLES={
  boundary:{color:"#9C27B0",weight:3,fillOpacity:0.03,dashArray:"8,5"},
  parks:{color:"#4caf50",weight:2,fillColor:"#4caf50",fillOpacity:0.3},
  parking:{color:"#2196f3",weight:2,fillColor:"#2196f3",fillOpacity:0.25},
  mixed_use:{color:"#ff9800",weight:2,fillColor:"#ff9800",fillOpacity:0.25},
  building_zones:{weight:1.5,fillOpacity:0.35}
};

var LAYER_NAMES={boundary:"Boundary",roads:"Roads",parks:"Parks",parking:"Parking",mixed_use:"Open Spaces",building_zones:"Building Zones",open_spaces:"Trees / Greenery"};
var LAYER_COLORS={boundary:"#9C27B0",roads:"#2e7d32",parks:"#4caf50",parking:"#2196f3",mixed_use:"#ff9800",building_zones:"#78909c",open_spaces:"#00bcd4"};

var SKIP_KEYS=["geometry"];
var layers={};

function showInfo(props,layerName,color){
  var panel=document.getElementById("info-panel");
  document.getElementById("info-title").textContent="Feature Info";
  var h="<div class='info-layer-tag' style='background:"+color+"'>"+layerName+"</div>";
  for(var k in props){
    if(SKIP_KEYS.indexOf(k)>=0)continue;
    var v=props[k];
    if(v===null||v===undefined||v==="")continue;
    h+="<div class='info-row'><span class='info-key'>"+k+"</span><span class='info-val'>"+safeStr(v)+"</span></div>";
  }
  document.getElementById("info-body").innerHTML=h;
  panel.style.display="block";
}
function closeInfo(){document.getElementById("info-panel").style.display="none"}

function clickHandler(layerKey){
  return function(f,l){
    l.on("click",function(e){
      L.DomEvent.stopPropagation(e);
      showInfo(f.properties,LAYER_NAMES[layerKey],LAYER_COLORS[layerKey]);
    });
  };
}

// Build layers
layers.boundary=L.geoJSON(DATA.boundary,{style:STYLES.boundary,onEachFeature:clickHandler("boundary")}).addTo(map);

layers.roads=L.geoJSON(DATA.roads,{
  style:function(f){var w=f.properties.width_m||0;return{color:wColor(w),weight:Math.max(2,Math.min(w*1.1,7)),opacity:0.8}},
  onEachFeature:function(f,l){
    l.bindTooltip(safeStr(f.properties.road_name)+" | "+(f.properties.width_m||"?")+"m",{sticky:true});
    l.on("click",function(e){L.DomEvent.stopPropagation(e);showInfo(f.properties,"Roads","#2e7d32")});
  }
}).addTo(map);

layers.parks=L.geoJSON(DATA.parks,{style:STYLES.parks,
  onEachFeature:function(f,l){l.bindTooltip(safeStr(f.properties.park_name),{sticky:true});clickHandler("parks")(f,l)}}).addTo(map);

layers.parking=L.geoJSON(DATA.parking,{style:STYLES.parking,
  onEachFeature:function(f,l){l.bindTooltip(safeStr(f.properties.park_name||f.properties.dig_name),{sticky:true});clickHandler("parking")(f,l)}}).addTo(map);

layers.mixed_use=L.geoJSON(DATA.mixed_use,{style:STYLES.mixed_use,
  onEachFeature:function(f,l){l.bindTooltip(safeStr(f.properties.dig_name),{sticky:true});clickHandler("mixed_use")(f,l)}}).addTo(map);

layers.building_zones=L.geoJSON(DATA.building_zones,{style:function(f){var c=floorColor(f.properties.floors);return{color:c,weight:1.5,fillColor:c,fillOpacity:0.35}},
  onEachFeature:function(f,l){l.bindTooltip("Zone: "+safeStr(f.properties.zone)+" | Floors: "+safeStr(f.properties.floors),{sticky:true});clickHandler("building_zones")(f,l)}}).addTo(map);

layers.open_spaces=L.geoJSON(DATA.open_spaces,{
  pointToLayer:function(f,ll){return L.circleMarker(ll,{radius:7,color:"#00bcd4",fillColor:"#00bcd4",fillOpacity:0.85,weight:2})},
  onEachFeature:function(f,l){l.bindTooltip(safeStr(f.properties.name)+" | "+safeStr(f.properties.type),{sticky:true});clickHandler("open_spaces")(f,l)}
}).addTo(map);

function toggle(key){
  var cb=document.getElementById("cb-"+key);
  cb.checked=!cb.checked;
  if(cb.checked)map.addLayer(layers[key]);else map.removeLayer(layers[key]);
}

map.on("click",function(){closeInfo()});

// Fit to boundary
var allPts=[];
DATA.boundary.features.forEach(function(f){f.geometry.coordinates[0].forEach(function(c){allPts.push([c[1],c[0]])})});
map.fitBounds(L.latLngBounds(allPts).pad(0.05));
</script>
